# ---------------------------------------------------------------------------
# fx-platform environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Historical data (research/backtesting path) ----------------------------
# Ships pointing at the SYNTHETIC sample so the quickstart works with zero
# setup. Point this at a REAL historical export (see sample_data/README_SAMPLE_DATA.md)
# before trusting any backtest number.
HISTORICAL_CSV_PATH=sample_data/EURUSD_sample.csv
# The sample file stores prices scaled by 100000 (integer-style), matching
# the convention in the original data_pipeline_ohlc.py. If you swap in a
# real export that already stores plain decimal prices (e.g. 1.0850), set
# this to 1.0 instead.
HISTORICAL_PRICE_SCALE=100000.0

# --- Database ---------------------------------------------------------------
# For local/sandbox testing you can leave this pointing at SQLite:
DATABASE_URL=sqlite:///./fx_platform.db
# On the VPS, point it at the docker-compose Postgres/TimescaleDB instead:
# DATABASE_URL=postgresql+psycopg2://fx:fx_password@db:5432/fx_platform

# --- Execution gateway --------------------------------------------------
# "mock"  = deterministic paper simulator, no broker needed, safe by default
# "mt5"   = real MetaTrader5 Python package, needs a running MT5 terminal
GATEWAY_MODE=mock

# --- MT5 connection (only used when GATEWAY_MODE=mt5) -----------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# --- Hard safety guard --------------------------------------------------
# The execution engine refuses to place a single order unless this is
# explicitly set to "demo". Real-money live trading requires deliberately
# changing this AND passing the validation gates in section 33 of the
# blueprint. This is not a formality - see app/execution_engine.py.
ACCOUNT_MODE=demo

# --- Risk limits (deterministic, section 14) --------------------------------
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0
MAX_DRAWDOWN_PCT=25.0
MAX_OPEN_POSITIONS=5
MAX_SYMBOL_EXPOSURE_PCT=10.0
MAX_PORTFOLIO_EXPOSURE_PCT=25.0
MAX_SPREAD_PIPS=3.0
MAX_SLIPPAGE_PIPS=2.0

# --- News / economic-calendar risk (section 12) ------------------------------
# none         = disabled (default; quickstart needs no internet)
# forexfactory = public weekly calendar JSON. UNOFFICIAL feed: fine for demo and
#                research; use a licensed provider before trading real money.
# file         = local JSON in the same format (set NEWS_CALENDAR_PATH)
NEWS_PROVIDER=none
NEWS_CALENDAR_PATH=
# NEWS_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# New trades are blocked from BEFORE minutes before a High-impact event until
# AFTER minutes after it, easing off over RAMP minutes either side.
NEWS_BLOCK_BEFORE_MIN=30
NEWS_BLOCK_AFTER_MIN=15
NEWS_RAMP_MIN=30
NEWS_REFRESH_MIN=30
# If a provider is set but its data is missing/older than STALE minutes:
# "closed" blocks new trades (safe default), "open" trades anyway with a warning.
NEWS_STALE_AFTER_MIN=360
NEWS_FAIL_MODE=closed

# --- Kill switch (blocks all NEW orders; does not close positions) ----------
# Trip it by setting KILL_SWITCH=1, or by creating the file below
# (`touch KILL_SWITCH` on the VPS; `rm KILL_SWITCH` to resume). Checked on
# every cycle and every API order.
KILL_SWITCH=0
KILL_SWITCH_FILE=KILL_SWITCH

# --- Symbols / timeframes (MVP scope, section 29) ----------------------
SYMBOLS=EURUSD,GBPUSD,USDJPY
TIMEFRAMES=M5,M15,H1

# --- API ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_AUTH_TOKEN=change-me
